{
  // Deploy-button discovery only; cf deploy uses cloudflare.config.ts.
  "name": "nju-qr",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "CAMPUS", "class_name": "CampusSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CampusSession"] }],
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
